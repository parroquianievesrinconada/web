---
interface Props {
  title?: string;
}
const { title = "Parroquia Rinconada" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Parroquia Rinconada</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;1,400&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <a href="/" class="logo">
          <span class="logo-parroquia">Parroquia</span>
          <span class="logo-nombre">Rinconada</span>
        </a>
        <nav>
          <a href="/">Inicio</a>
          <a href="/anuncios">Anuncios</a>
          <a href="/horarios">Horarios</a>
          <a href="/contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <p>Parroquia Rinconada &copy; {new Date().getFullYear()}</p>
        <a href="/admin/" class="admin-link">Panel</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --color-primary: #7a3e2b;
    --color-primary-light: #9a5a3f;
    --color-bg: #fdf8f3;
    --color-text: #2c2c2c;
    --color-muted: #6b6b6b;
    --color-border: #e0d5c8;
    --font-serif: "Lora", Georgia, serif;
    --font-sans: "Open Sans", system-ui, sans-serif;
    --max-width: 900px;
  }

  html { font-size: 16px; scroll-behavior: smooth; }

  body {
    font-family: var(--font-sans);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main { flex: 1; }

  a { color: var(--color-primary); text-decoration: none; }
  a:hover { text-decoration: underline; }

  img { max-width: 100%; height: auto; display: block; }

  h1, h2, h3 { font-family: var(--font-serif); line-height: 1.3; }

  /* Header */
  header {
    background: #fff;
    border-bottom: 2px solid var(--color-primary);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
  }

  .logo-parroquia {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .logo-nombre {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-primary);
    font-weight: 600;
  }

  nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }

  nav a {
    font-size: 0.9rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  nav a:hover { color: var(--color-primary); text-decoration: none; }

  /* Footer */
  footer {
    background: var(--color-primary);
    color: #fff;
    padding: 1.2rem 1.5rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }

  .admin-link { color: rgba(255,255,255,0.6); font-size: 0.75rem; }
  .admin-link:hover { color: #fff; }

  /* Utilidades */
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  @media (max-width: 600px) {
    nav { gap: 1rem; }
    .header-inner { flex-wrap: wrap; }
  }
</style>
