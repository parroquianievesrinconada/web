---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const entrada = await getEntry("paginas", "hermandad-salud");
const { Content } = await render(entrada);
---

<Layout title="Hermandad de la Salud">
  <div class="hero-hmd" style="background: linear-gradient(135deg, #0a2a0a, #1a5a2a);">
    <div class="container">
      <p class="hmd-label">Hermandad de</p>
      <h1>Nuestra Señora de la Salud</h1>
      <p>Parroquia de La Rinconada · Fundada en 1954</p>
    </div>
  </div>
  <div class="container">
    <div class="cuerpo">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .hero-hmd { color: #fff; padding: 3rem 0; }
  .hmd-label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.7; }
  .hero-hmd h1 { color: #fff; font-size: 1.8rem; margin: 0.25rem 0 0.5rem; }
  .hero-hmd p { opacity: 0.8; }

  .cuerpo { max-width: 760px; font-size: 1rem; line-height: 1.8; padding-top: 0.5rem; }
  .cuerpo :global(p) { margin-bottom: 1rem; }
  .cuerpo :global(h2) {
    font-size: 1.3rem;
    color: var(--color-primary);
    margin: 2rem 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cuerpo :global(ul) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .cuerpo :global(li) { margin-bottom: 0.4rem; }
  .cuerpo :global(a) { color: var(--color-primary); }
</style>
