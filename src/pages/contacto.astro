---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

const entrada = await getEntry("paginas", "contacto");
const datos = {
  title: "Contacto",
  direccion: "",
  telefono: "",
  email: "",
  mapa: "",
  ...entrada?.data,
};

const enviado = Astro.url.searchParams.get("enviado") === "1";
---

<Layout title="Contacto">
  <div class="container">
    <h1>{datos.title}</h1>

    <div class="pagina-grid">
      <div class="columna-info">
        {datos.direccion && (
          <div class="campo">
            <span class="icono">📍</span>
            <div>
              <strong>Dirección</strong>
              <p>{datos.direccion}</p>
            </div>
          </div>
        )}
        {datos.telefono && (
          <div class="campo">
            <span class="icono">📞</span>
            <div>
              <strong>Teléfono</strong>
              <p><a href={`tel:${datos.telefono}`}>{datos.telefono}</a></p>
            </div>
          </div>
        )}
        {datos.email && (
          <div class="campo">
            <span class="icono">✉️</span>
            <div>
              <strong>Correo electrónico</strong>
              <p><a href={`mailto:${datos.email}`}>{datos.email}</a></p>
            </div>
          </div>
        )}

        {datos.mapa && (
          <div class="mapa" set:html={datos.mapa} />
        )}
      </div>

      <div class="columna-form">
        <h2>Escríbenos</h2>

        {enviado ? (
          <div class="aviso-ok">
            <strong>Mensaje enviado.</strong> Nos pondremos en contacto contigo en breve.
          </div>
        ) : (
          <form
            name="contacto"
            method="POST"
            action="/contacto?enviado=1"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="formulario"
          >
            <input type="hidden" name="form-name" value="contacto" />
            <p class="oculto">
              <label>No rellenar: <input name="bot-field" /></label>
            </p>

            <div class="campo-form">
              <label for="nombre">Nombre</label>
              <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" />
            </div>

            <div class="campo-form">
              <label for="email">Correo electrónico</label>
              <input type="email" id="email" name="email" required placeholder="tucorreo@ejemplo.com" />
            </div>

            <div class="campo-form">
              <label for="asunto">Asunto</label>
              <input type="text" id="asunto" name="asunto" required placeholder="Motivo del mensaje" />
            </div>

            <div class="campo-form">
              <label for="mensaje">Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="5" required placeholder="Escribe tu mensaje aquí..."></textarea>
            </div>

            <button type="submit">Enviar mensaje</button>
          </form>
        )}
      </div>
    </div>
  </div>
</Layout>

<style>
  h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  h2 {
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .pagina-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Info de contacto */
  .campo {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
  }

  .icono { font-size: 1.5rem; flex-shrink: 0; }

  .campo strong {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }

  .campo p { margin: 0; }

  .mapa :global(iframe) { width: 100%; border-radius: 6px; border: 1px solid var(--color-border); margin-top: 1rem; }

  /* Formulario */
  .formulario { display: flex; flex-direction: column; gap: 1rem; }

  .campo-form { display: flex; flex-direction: column; gap: 0.3rem; }

  .campo-form label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .campo-form input,
  .campo-form textarea {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    background: #fff;
    color: var(--color-text);
    transition: border-color 0.2s;
    width: 100%;
  }

  .campo-form input:focus,
  .campo-form textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(122, 62, 43, 0.1);
  }

  .campo-form textarea { resize: vertical; }

  button[type="submit"] {
    background: var(--color-primary);
    color: #fff;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    align-self: flex-start;
    transition: background 0.2s;
  }

  button[type="submit"]:hover { background: var(--color-primary-light); }

  .oculto { display: none; }

  .aviso-ok {
    background: #f0faf0;
    border: 1px solid #a3d9a5;
    color: #2d6a30;
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .pagina-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
