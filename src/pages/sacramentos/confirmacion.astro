---
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";

const entrada = await getEntry("paginas", "confirmacion");
marked.setOptions({ gfm: true, breaks: false });

const htmlInfo = entrada?.data.informacion ? await marked.parse(entrada.data.informacion) : "";
const htmlReq = entrada?.data.requisitos ? await marked.parse(entrada.data.requisitos) : "";
const htmlCat = entrada?.data.catequesis ? await marked.parse(entrada.data.catequesis) : "";
const htmlNota = entrada?.data.nota ? await marked.parse(entrada.data.nota) : "";

const pasos = entrada?.data.pasos ?? [];
---

<Layout title={entrada?.data.title ?? "Confirmación"}>
  <div class="hero-interior">
    <div class="container">
      <h1>{entrada?.data.title ?? "Confirmación"}</h1>
      {entrada?.data.intro && <p>{entrada.data.intro}</p>}
    </div>
  </div>

  <div class="container">
    {htmlInfo && (
      <section class="bloque">
        <h2 class="bloque-titulo">Información</h2>
        <div class="bloque-cuerpo" set:html={htmlInfo} />
      </section>
    )}

    {htmlReq && (
      <section class="bloque">
        <h2 class="bloque-titulo">Requisitos</h2>
        <div class="bloque-cuerpo" set:html={htmlReq} />
      </section>
    )}

    {pasos.length > 0 && (
      <section class="bloque">
        <h2 class="bloque-titulo">Pasos a seguir</h2>
        <div class="pasos-grid">
          {pasos.map((p, i) => (
            <div class="paso-card">
              <span class="paso-num">{i + 1}</span>
              <h3>{p.titulo}</h3>
              {p.descripcion && <p>{p.descripcion}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    {htmlCat && (
      <section class="bloque" id="catequesis">
        <h2 class="bloque-titulo">Catequesis de Confirmación</h2>
        <div class="bloque-cuerpo" set:html={htmlCat} />
      </section>
    )}

    {htmlNota && (
      <section class="bloque bloque-nota">
        <div class="bloque-cuerpo" set:html={htmlNota} />
      </section>
    )}

  </div>
</Layout>

<style>
  .hero-interior { background: linear-gradient(135deg, #4a2515, #7a4020); color: #fff; padding: 3rem 0; }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.9; font-size: 1.05rem; }

  .bloque {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.75rem 1.75rem;
    margin-bottom: 1.5rem;
  }

  .bloque-titulo {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }

  .bloque-cuerpo :global(p) { margin-bottom: 0.9rem; line-height: 1.75; }
  .bloque-cuerpo :global(img) { max-width: 100%; border-radius: 6px; margin: 1rem 0; }
  .bloque-cuerpo :global(ul),
  .bloque-cuerpo :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .bloque-cuerpo :global(li) { margin-bottom: 0.4rem; line-height: 1.65; }
  .bloque-cuerpo :global(h2) { font-size: 1.05rem; color: var(--color-primary); margin: 1.5rem 0 0.6rem; }
  .bloque-cuerpo :global(h3) { font-size: 0.95rem; color: var(--color-primary); margin: 1.2rem 0 0.4rem; }
  .bloque-cuerpo :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    background: var(--color-bg);
    padding: 0.75rem 1rem;
    margin: 0.5rem 0 1rem;
    color: var(--color-muted);
    font-style: italic;
    font-size: 0.9rem;
  }

  .pasos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .paso-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.5rem 1.25rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .paso-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 auto 0.25rem;
  }

  .paso-card h3 {
    font-size: 1rem;
    color: var(--color-primary);
    margin: 0;
  }

  .paso-card p {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .bloque-nota {
    background: var(--color-bg);
    border-style: dashed;
  }

  .contacto-final {
    text-align: center;
    padding: 2.5rem 1rem;
    border-top: 2px solid var(--color-border);
    margin-top: 2.5rem;
  }

  .contacto-final h2 {
    font-size: 1.15rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .contacto-final p { color: var(--color-muted); }

  @media (max-width: 700px) {
    .pasos-grid { grid-template-columns: 1fr; }
  }
</style>
