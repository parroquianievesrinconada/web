---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const fechaDeAnuncio = (anuncio: any): Date => {
  if (anuncio.data.date) return new Date(anuncio.data.date);
  const match = anuncio.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

const anuncios = (await getCollection("anuncios"))
  .sort((a, b) => fechaDeAnuncio(b).valueOf() - fechaDeAnuncio(a).valueOf())
  .slice(0, 4);

const principal = anuncios[0];
const secundarios = anuncios.slice(1);
---

<Layout title="Inicio">
  <section class="hero">
    <div class="hero-inner">
      <h1>Bienvenidos a la Parroquia Rinconada</h1>
      <p>Comunidad de fe al servicio de todos</p>
    </div>
  </section>

  <div class="container">
    <section class="noticias">
      <div class="section-header">
        <h2>Últimas noticias</h2>
        <a href="/anuncios">Ver todas →</a>
      </div>

      {anuncios.length === 0 ? (
        <p class="vacio">No hay anuncios publicados todavía.</p>
      ) : (
        <div class="noticias-grid">
          {principal && (
            <article class="noticia-principal">
              {principal.data.image && (
                <a href={`/anuncios/${principal.id}`} class="principal-img-wrap">
                  <img src={principal.data.image} alt={principal.data.title} class="principal-img" />
                </a>
              )}
              <div class="principal-cuerpo">
                <time class="noticia-fecha">{formatFecha(fechaDeAnuncio(principal))}</time>
                <h3 class="principal-titulo">
                  <a href={`/anuncios/${principal.id}`}>{principal.data.title}</a>
                </h3>
                <p class="principal-resumen">{principal.data.summary}</p>
                <a href={`/anuncios/${principal.id}`} class="leer-mas">Leer más →</a>
              </div>
            </article>
          )}

          {secundarios.length > 0 && (
            <div class="noticias-secundarias">
              {secundarios.map((anuncio) => (
                <article class="noticia-secundaria">
                  <div class="secundaria-cuerpo">
                    <time class="noticia-fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
                    <h4><a href={`/anuncios/${anuncio.id}`}>{anuncio.data.title}</a></h4>
                    <p>{anuncio.data.summary}</p>
                  </div>
                  {anuncio.data.image && (
                    <a href={`/anuncios/${anuncio.id}`} class="secundaria-img-wrap">
                      <img src={anuncio.data.image} alt={anuncio.data.title} class="secundaria-img" />
                    </a>
                  )}
                </article>
              ))}
            </div>
          )}
        </div>
      )}
    </section>

    <section class="bloques">
      <a href="/horarios" class="bloque">
        <span class="bloque-icono">🕐</span>
        <h3>Horarios de misas</h3>
        <p>Consulta los horarios de celebraciones</p>
      </a>
      <a href="/contacto" class="bloque">
        <span class="bloque-icono">📍</span>
        <h3>Contacto y ubicación</h3>
        <p>Encuéntranos y ponte en contacto</p>
      </a>
      <a href="/anuncios" class="bloque">
        <span class="bloque-icono">📢</span>
        <h3>Tablón de anuncios</h3>
        <p>Todas las noticias de la parroquia</p>
      </a>
    </section>
  </div>
</Layout>

<style>
  .hero {
    background: var(--color-primary);
    color: #fff;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .hero-inner { max-width: var(--max-width); margin: 0 auto; }

  .hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: 0.75rem;
  }

  .hero p { font-size: 1.1rem; opacity: 0.85; }

  /* Cabecera de sección */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 0.5rem;
  }

  .section-header h2 { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); }
  .section-header a { font-size: 0.85rem; }

  .vacio { color: var(--color-muted); font-style: italic; margin-bottom: 2rem; }

  /* Grid editorial */
  .noticias-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin-bottom: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  /* Noticia principal */
  .noticia-principal {
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .principal-img-wrap { display: block; overflow: hidden; }

  .principal-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }

  .principal-img-wrap:hover .principal-img { transform: scale(1.03); }

  .principal-cuerpo {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: #fff;
  }

  .noticia-fecha {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    font-weight: 600;
  }

  .principal-titulo {
    font-size: 1.35rem;
    line-height: 1.25;
    margin: 0;
  }

  .principal-titulo a { color: var(--color-text); text-decoration: none; }
  .principal-titulo a:hover { color: var(--color-primary); }

  .principal-resumen {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }

  .leer-mas { font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }

  /* Noticias secundarias */
  .noticias-secundarias {
    display: flex;
    flex-direction: column;
  }

  .noticia-secundaria {
    display: flex;
    gap: 0;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    transition: background 0.15s;
  }

  .noticia-secundaria:last-child { border-bottom: none; }
  .noticia-secundaria:hover { background: #faf6f2; }

  .secundaria-cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .secundaria-cuerpo h4 {
    font-size: 0.95rem;
    line-height: 1.3;
    margin: 0;
    font-family: var(--font-serif);
  }

  .secundaria-cuerpo h4 a { color: var(--color-text); text-decoration: none; }
  .secundaria-cuerpo h4 a:hover { color: var(--color-primary); }

  .secundaria-cuerpo p {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .secundaria-img-wrap { flex-shrink: 0; margin-left: 0.75rem; }

  .secundaria-img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 3px;
    display: block;
  }

  /* Bloques de acceso rápido */
  .bloques {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .bloque {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.5rem;
    text-align: center;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .bloque:hover {
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(122, 62, 43, 0.1);
    text-decoration: none;
  }

  .bloque-icono { font-size: 2rem; display: block; margin-bottom: 0.5rem; }
  .bloque h3 { font-size: 1rem; margin-bottom: 0.3rem; }
  .bloque p { font-size: 0.85rem; color: var(--color-muted); }

  @media (max-width: 620px) {
    .noticias-grid { grid-template-columns: 1fr; }
    .noticia-principal { border-right: none; border-bottom: 1px solid var(--color-border); }
  }
</style>
