---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const fechaDeAnuncio = (anuncio: any): Date => {
  if (anuncio.data.date) return new Date(anuncio.data.date);
  const match = anuncio.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

const anuncios = (await getCollection("anuncios"))
  .sort((a, b) => fechaDeAnuncio(b).valueOf() - fechaDeAnuncio(a).valueOf())
  .slice(0, 4);

const principal = anuncios[0];
const secundarios = anuncios.slice(1);
---

<Layout title="Inicio">

  <!-- BANNER ROTATIVO -->
  <div class="banner" aria-label="Fotos de la parroquia">
    <div class="slides">
      <div class="slide active">
        <img src="/uploads/rotativo-1.webp" alt="Parroquia Nuestra Señora de las Nieves" class="slide-img" fetchpriority="high" />
        <div class="slide-overlay"></div>
        <div class="slide-texto">
          <h1>Parroquia Nuestra Señora de las Nieves</h1>
          <p>Comunidad de fe, esperanza y caridad</p>
        </div>
      </div>
      <div class="slide">
        <img src="/uploads/rotativo-2.webp" alt="Bienvenidos a nuestra casa" class="slide-img" loading="lazy" />
        <div class="slide-overlay"></div>
        <div class="slide-texto">
          <h1>Bienvenidos a nuestra casa</h1>
          <p>Un lugar de encuentro para todos</p>
        </div>
      </div>
      <div class="slide">
        <img src="/uploads/rotativo-3.webp" alt="Juntos en el camino" class="slide-img" loading="lazy" />
        <div class="slide-overlay"></div>
        <div class="slide-texto">
          <h1>Juntos en el camino</h1>
          <p>Vida sacramental · Catequesis · Hermandades</p>
        </div>
      </div>
    </div>
    <div class="dots" aria-hidden="true">
      <button class="dot active" data-slide="0"></button>
      <button class="dot" data-slide="1"></button>
      <button class="dot" data-slide="2"></button>
    </div>
    <button class="arrow arrow-prev" aria-label="Anterior">&#8249;</button>
    <button class="arrow arrow-next" aria-label="Siguiente">&#8250;</button>
  </div>

  <!-- ACCESO RÁPIDO -->
  <div class="acceso-rapido">
    <a href="/parroquia/horarios" class="acceso-btn">
      <span class="acceso-icono">🕐</span>
      <span class="acceso-label">Horarios de Misa</span>
    </a>
    <a href="/actualidad" class="acceso-btn">
      <span class="acceso-icono">📢</span>
      <span class="acceso-label">Noticias</span>
    </a>
    <a href="/contacto" class="acceso-btn">
      <span class="acceso-icono">📍</span>
      <span class="acceso-label">Contacto</span>
    </a>
  </div>

  <!-- ÚLTIMAS NOTICIAS -->
  <div class="container">
    <section class="noticias">
      <div class="section-header">
        <h2>Últimas noticias</h2>
        <a href="/actualidad">Ver todas →</a>
      </div>

      {anuncios.length === 0 ? (
        <p class="vacio">No hay anuncios publicados todavía.</p>
      ) : (
        <div class="noticias-grid">
          {principal && (
            <article class="noticia-principal">
              {principal.data.image && (
                <a href={`/actualidad/${principal.id}`} class="principal-img-wrap">
                  <img src={principal.data.image} alt={principal.data.title} class="principal-img" loading="lazy" />
                </a>
              )}
              <div class="principal-cuerpo">
                <time class="noticia-fecha">{formatFecha(fechaDeAnuncio(principal))}</time>
                <h3 class="principal-titulo">
                  <a href={`/actualidad/${principal.id}`}>{principal.data.title}</a>
                </h3>
                <p class="principal-resumen">{principal.data.summary}</p>
                <a href={`/actualidad/${principal.id}`} class="leer-mas">Leer más →</a>
              </div>
            </article>
          )}
          {secundarios.length > 0 && (
            <div class="noticias-secundarias">
              {secundarios.map((anuncio) => (
                <article class="noticia-secundaria">
                  <div class="secundaria-cuerpo">
                    <time class="noticia-fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
                    <h4><a href={`/actualidad/${anuncio.id}`}>{anuncio.data.title}</a></h4>
                    <p>{anuncio.data.summary}</p>
                  </div>
                  {anuncio.data.image && (
                    <a href={`/actualidad/${anuncio.id}`} class="secundaria-img-wrap">
                      <img src={anuncio.data.image} alt={anuncio.data.title} class="secundaria-img" loading="lazy" />
                    </a>
                  )}
                </article>
              ))}
            </div>
          )}
        </div>
      )}
    </section>
  </div>

  <script is:inline>
    var slides = document.querySelectorAll(".slide");
    var dots = document.querySelectorAll(".dot");
    var current = 0;
    var timer;

    function goTo(n) {
      slides[current].classList.remove("active");
      dots[current].classList.remove("active");
      current = (n + slides.length) % slides.length;
      slides[current].classList.add("active");
      dots[current].classList.add("active");
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(next, 5000);
    }

    timer = setInterval(next, 5000);

    dots.forEach(function (dot) {
      dot.addEventListener("click", function () {
        goTo(parseInt(dot.dataset.slide));
        resetTimer();
      });
    });

    document.querySelector(".arrow-next").addEventListener("click", function () { next(); resetTimer(); });
    document.querySelector(".arrow-prev").addEventListener("click", function () { prev(); resetTimer(); });
  </script>
</Layout>

<style>
  /* ── BANNER ── */
  .banner {
    position: relative;
    height: 480px;
    overflow: hidden;
    background: #3a2218;
  }

  .slides { height: 100%; }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .slide.active { opacity: 1; }

  .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
  }

  .slide-texto {
    text-align: center;
    color: #fff;
    padding: 2rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  }

  .slide-texto h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .slide-texto p {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    opacity: 0.9;
  }

  .dots {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s;
  }

  .dot.active { background: #fff; }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .arrow:hover { background: rgba(255,255,255,0.3); }
  .arrow-prev { left: 1rem; }
  .arrow-next { right: 1rem; }

  /* ── ACCESO RÁPIDO ── */
  .acceso-rapido {
    display: flex;
    justify-content: center;
    gap: 0;
    background: var(--color-primary);
    flex-wrap: wrap;
  }

  .acceso-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.1rem 2rem;
    color: #fff;
    text-decoration: none;
    border-right: 1px solid rgba(255,255,255,0.2);
    transition: background 0.2s;
    min-width: 130px;
  }

  .acceso-btn:last-child { border-right: none; }
  .acceso-btn:hover { background: rgba(255,255,255,0.12); text-decoration: none; color: #fff; }

  .acceso-icono { font-size: 1.6rem; }
  .acceso-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  /* ── NOTICIAS ── */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 0.5rem;
  }

  .section-header h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); }
  .section-header a { font-size: 0.85rem; }

  .vacio { color: var(--color-muted); font-style: italic; }

  .noticias-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .noticia-principal { border-right: 1px solid var(--color-border); display: flex; flex-direction: column; }
  .principal-img-wrap { display: block; overflow: hidden; }
  .principal-img { width: 100%; height: 220px; object-fit: cover; transition: transform 0.3s; display: block; }
  .principal-img-wrap:hover .principal-img { transform: scale(1.03); }
  .principal-cuerpo { padding: 1.25rem; flex: 1; display: flex; flex-direction: column; gap: 0.5rem; background: #fff; }

  .noticia-fecha { font-size: 0.73rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-primary); font-weight: 600; }

  .principal-titulo { font-size: 1.3rem; line-height: 1.25; }
  .principal-titulo a { color: var(--color-text); }
  .principal-titulo a:hover { color: var(--color-primary); text-decoration: none; }
  .principal-resumen { font-size: 0.88rem; color: var(--color-muted); line-height: 1.6; flex: 1; }
  .leer-mas { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }

  .noticias-secundarias { display: flex; flex-direction: column; }

  .noticia-secundaria {
    display: flex;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    transition: background 0.15s;
  }

  .noticia-secundaria:last-child { border-bottom: none; }
  .noticia-secundaria:hover { background: #faf6f2; }

  .secundaria-cuerpo { flex: 1; display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .secundaria-cuerpo h4 { font-size: 0.92rem; line-height: 1.3; font-family: var(--font-serif); }
  .secundaria-cuerpo h4 a { color: var(--color-text); }
  .secundaria-cuerpo h4 a:hover { color: var(--color-primary); text-decoration: none; }
  .secundaria-cuerpo p { font-size: 0.8rem; color: var(--color-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .secundaria-img-wrap { flex-shrink: 0; margin-left: 0.75rem; }
  .secundaria-img { width: 68px; height: 68px; object-fit: cover; border-radius: 3px; }

  @media (max-width: 620px) {
    .banner { height: 300px; }
    .noticias-grid { grid-template-columns: 1fr; }
    .noticia-principal { border-right: none; border-bottom: 1px solid var(--color-border); }
    .acceso-btn { min-width: unset; flex: 1; padding: 1rem 0.75rem; }
    .acceso-label { font-size: 0.7rem; }
  }
</style>
