---
import Layout from "../layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { extractoDeAnuncio } from "../lib/anuncios";

const inicio = await getEntry("paginas", "inicio");

const banner = inicio?.data.banner?.length
  ? inicio.data.banner
  : [
      {
        imagen: "/uploads/rotativo-1.webp",
        alt: "Parroquia Nuestra Señora de las Nieves de la Rinconada",
        titulo: "Parroquia Nuestra Señora de las Nieves de la Rinconada",
        texto: "Comunidad de fe, esperanza y caridad",
        ajuste: "completa" as const,
      },
    ];

const qrWhatsapp = inicio?.data.qrWhatsapp ?? "/uploads/qr-whatsapp.webp";

const fechaDeAnuncio = (anuncio: any): Date => {
  if (anuncio.data.date) return new Date(anuncio.data.date);
  const match = anuncio.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });

const anuncios = (await getCollection("anuncios"))
  .sort((a, b) => fechaDeAnuncio(b).valueOf() - fechaDeAnuncio(a).valueOf())
  .slice(0, 3);
---

<Layout title="Inicio">

  <!-- BANNER ROTATIVO -->
  <div class="banner" aria-label="Fotos de la parroquia">
    <div class="slides">
      {banner.map((slide, i) => (
        <div class:list={["slide", i === 0 && "active"]}>
          {slide.ajuste === "completa" && (
            <img src={slide.imagen} alt="" class="slide-bg" aria-hidden="true" />
          )}
          <img
            src={slide.imagen}
            alt={slide.alt ?? ""}
            class:list={["slide-img", slide.ajuste === "completa" && "slide-img-contain"]}
            style={slide.posicion ? `object-position: ${slide.posicion};` : undefined}
            fetchpriority={i === 0 ? "high" : undefined}
            loading={i === 0 ? undefined : "lazy"}
          />
          <div class="slide-overlay"></div>
          <div class="slide-texto">
            {slide.titulo && <h1>{slide.titulo}</h1>}
            {slide.texto && <p>{slide.texto}</p>}
          </div>
        </div>
      ))}
    </div>
    {banner.length > 1 && (
      <>
        <div class="dots" aria-hidden="true">
          {banner.map((_, i) => (
            <button class:list={["dot", i === 0 && "active"]} data-slide={i}></button>
          ))}
        </div>
        <button class="arrow arrow-prev" aria-label="Anterior">&#8249;</button>
        <button class="arrow arrow-next" aria-label="Siguiente">&#8250;</button>
      </>
    )}
  </div>

  <!-- ACCESO RÁPIDO -->
  <div class="acceso-rapido">
    <a href="/parroquia/horarios" class="acceso-btn">
      <span class="acceso-icono">🕐</span>
      <span class="acceso-label">Horarios de Misa</span>
    </a>
    <a href="/parroquia/horarios#prebautismal" class="acceso-btn">
      <span class="acceso-icono">🕐</span>
      <span class="acceso-label">Calendario de Cursos Prebautismales</span>
    </a>
    <a href="/actualidad" class="acceso-btn">
      <span class="acceso-icono">📢</span>
      <span class="acceso-label">Anuncios</span>
    </a>
    <a href="/contacto" class="acceso-btn">
      <span class="acceso-icono">📍</span>
      <span class="acceso-label">Contacto</span>
    </a>
  </div>

  <!-- ÚLTIMOS ANUNCIOS + QR WHATSAPP -->
  <div class="container container-ancho">
    <div class="inicio-grid">
      <section class="noticias">
        <div class="section-header">
          <h2>Últimos anuncios</h2>
          <a href="/actualidad">Ver todas →</a>
        </div>

        {anuncios.length === 0 ? (
          <p class="vacio">No hay anuncios publicados todavía.</p>
        ) : (
          <div class="noticias-grid">
            {anuncios.map((anuncio, i) => (
              <article class:list={["noticia", i === 0 && "noticia-destacada"]}>
                {anuncio.data.galeria?.[0]?.imagen && (
                  <a href={`/actualidad/${anuncio.id}`} class="noticia-img-wrap">
                    <img src={anuncio.data.galeria[0].imagen} alt={anuncio.data.title} class="noticia-img" loading="lazy" />
                  </a>
                )}
                <div class="noticia-cuerpo">
                  <time class="noticia-fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
                  <h3 class="noticia-titulo">
                    <a href={`/actualidad/${anuncio.id}`}>{anuncio.data.title}</a>
                  </h3>
                  {extractoDeAnuncio(anuncio.body) && <p class="noticia-resumen">{extractoDeAnuncio(anuncio.body)}</p>}
                  <a href={`/actualidad/${anuncio.id}`} class="leer-mas">Leer más →</a>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      <aside class="whatsapp-card">
        <h3>Únete a nuestro grupo de WhatsApp</h3>
        <p>Escanea el código QR para estar al tanto de todos los anuncios de la parroquia.</p>
        <img src={qrWhatsapp} alt="Código QR para unirse al grupo de WhatsApp de la parroquia" class="qr-img" />
      </aside>
    </div>
  </div>

  <script is:inline>
    var slides = document.querySelectorAll(".slide");
    var dots = document.querySelectorAll(".dot");
    var current = 0;
    var timer;

    function goTo(n) {
      slides[current].classList.remove("active");
      dots[current].classList.remove("active");
      current = (n + slides.length) % slides.length;
      slides[current].classList.add("active");
      dots[current].classList.add("active");
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function resetTimer() {
      clearInterval(timer);
      timer = setInterval(next, 5000);
    }

    timer = setInterval(next, 5000);

    dots.forEach(function (dot) {
      dot.addEventListener("click", function () {
        goTo(parseInt(dot.dataset.slide));
        resetTimer();
      });
    });

    document.querySelector(".arrow-next").addEventListener("click", function () { next(); resetTimer(); });
    document.querySelector(".arrow-prev").addEventListener("click", function () { prev(); resetTimer(); });
  </script>
</Layout>

<style>
  /* ── BANNER ── */
  .banner {
    position: relative;
    height: 480px;
    overflow: hidden;
    background: #3a2218;
  }

  .slides { height: 100%; }

  .slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .slide.active { opacity: 1; }

  .slide-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(35px) brightness(0.6);
    transform: scale(1.15);
  }

  .slide-img-contain {
    object-fit: contain;
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.42);
  }

  .slide-texto {
    position: relative;
    text-align: center;
    color: #fff;
    padding: 2rem;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  }

  .slide-texto h1 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .slide-texto p {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    opacity: 0.9;
  }

  .dots {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.5);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s;
  }

  .dot.active { background: #fff; }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    font-size: 2.5rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .arrow:hover { background: rgba(255,255,255,0.3); }
  .arrow-prev { left: 1rem; }
  .arrow-next { right: 1rem; }

  /* ── ACCESO RÁPIDO ── */
  .acceso-rapido {
    display: flex;
    justify-content: center;
    gap: 0;
    background: var(--color-primary);
    flex-wrap: wrap;
  }

  .acceso-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1.1rem 2rem;
    color: #fff;
    text-decoration: none;
    border-right: 1px solid rgba(255,255,255,0.2);
    transition: background 0.2s;
    min-width: 130px;
  }

  .acceso-btn:last-child { border-right: none; }
  .acceso-btn:hover { background: rgba(255,255,255,0.12); text-decoration: none; color: #fff; }

  .acceso-icono { font-size: 1.6rem; }
  .acceso-label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }

  /* ── INICIO: ANUNCIOS + WHATSAPP ── */
  .container-ancho {
    max-width: 1280px;
  }

  .inicio-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .whatsapp-card {
    background: linear-gradient(160deg, #e9f9ee, #d5f2df);
    border: 1px solid #8fd9a8;
    border-radius: 6px;
    padding: 1.5rem;
    text-align: center;
  }

  .whatsapp-card h3 {
    font-size: 1rem;
    color: #1f7a3d;
    margin-bottom: 0.6rem;
  }

  .whatsapp-card p {
    font-size: 0.85rem;
    color: #3a6b4a;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .qr-img {
    width: 100%;
    max-width: 220px;
    margin: 0 auto;
    border-radius: 4px;
    border: 1px solid #8fd9a8;
    background: #fff;
    padding: 0.5rem;
  }

  /* ── NOTICIAS ── */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 0.5rem;
  }

  .section-header h2 { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); }
  .section-header a { font-size: 0.85rem; }

  .vacio { color: var(--color-muted); font-style: italic; }

  /* Últimos 3 anuncios en columnas; el más reciente, algo más ancho */
  .noticias-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .noticia { display: flex; flex-direction: column; border: 1px solid var(--color-border); border-radius: 4px; overflow: hidden; background: #fff; }
  .noticia-img-wrap { display: block; overflow: hidden; }
  /* Los carteles suelen llevar el título arriba: se muestra la parte superior */
  .noticia-img { width: 100%; height: 170px; object-fit: cover; object-position: center top; transition: transform 0.3s; display: block; }
  .noticia-destacada .noticia-img { height: 200px; }
  .noticia-img-wrap:hover .noticia-img { transform: scale(1.03); }
  .noticia-cuerpo { padding: 1rem; flex: 1; display: flex; flex-direction: column; gap: 0.4rem; }

  .noticia-fecha { font-size: 0.73rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-primary); font-weight: 600; }

  .noticia-titulo { font-size: 1rem; line-height: 1.3; }
  .noticia-destacada .noticia-titulo { font-size: 1.15rem; }
  .noticia-titulo a { color: var(--color-text); }
  .noticia-titulo a:hover { color: var(--color-primary); text-decoration: none; }
  .noticia-resumen { font-size: 0.84rem; color: var(--color-muted); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .leer-mas { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-top: auto; padding-top: 0.4rem; }

  @media (max-width: 820px) {
    .inicio-grid { grid-template-columns: 1fr; }
    .whatsapp-card { max-width: 320px; margin: 0 auto; }
  }

  @media (max-width: 620px) {
    .banner { height: 300px; }
    .noticias-grid { grid-template-columns: 1fr; }
    .acceso-btn { min-width: unset; flex: 1; padding: 1rem 0.75rem; }
    .acceso-label { font-size: 0.7rem; }
  }
</style>
