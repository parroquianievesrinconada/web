---
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";

const entrada = await getEntry("paginas", "horarios");
const d = entrada?.data;

const tieneMisas = !!d?.misas && d.misas.filas.length > 0;
const tienePrebautismal = !!d?.prebautismal && d.prebautismal.filas.length > 0;
const tieneConfesiones = !!d?.confesiones && !!d.confesiones.texto;
const tieneDespacho = !!d?.despacho && d.despacho.filas.length > 0;

const hayContenido = tieneMisas || tienePrebautismal || tieneConfesiones || tieneDespacho;
---

<Layout title="Horarios">
  <div class="hero-interior">
    <div class="container">
      <h1>Horarios</h1>
      <p>Misas, cursos prebautismales, confesiones y despacho parroquial</p>
    </div>
  </div>

  <div class="container">
    {!hayContenido ? (
      <p class="vacio">No hay horarios publicados todavía.</p>
    ) : (
      <div class="grid-horarios">

        <div class="columna">
          {tieneMisas && (
            <section class="bloque">
              <h2>Horario de misas</h2>
              <table>
                <thead>
                  <tr><th>Día</th><th>Horario</th></tr>
                </thead>
                <tbody>
                  {d.misas.filas.map((f) => (
                    <tr><td>{f.dias}</td><td>{f.horario}</td></tr>
                  ))}
                </tbody>
              </table>
            </section>
          )}

          {tieneDespacho && (
            <section class="bloque" id="despacho">
              <h2>Despacho parroquial</h2>
              <table>
                <thead>
                  <tr><th>Día</th><th>Horario</th></tr>
                </thead>
                <tbody>
                  {d.despacho.filas.map((f) => (
                    <tr><td>{f.dias}</td><td>{f.horario}</td></tr>
                  ))}
                </tbody>
              </table>
              {d.despacho.nota && <p class="nota">{d.despacho.nota}</p>}
            </section>
          )}

          {tieneConfesiones && (
            <section class="bloque" id="confesiones">
              <h2>Confesiones</h2>
              <p class="texto-simple">{d.confesiones.texto}</p>
            </section>
          )}
        </div>

        <div class="columna">
          {tienePrebautismal && (
            <section class="bloque" id="prebautismal">
              <h2>Cursos prebautismales</h2>
              <table>
                <thead>
                  <tr><th>Fecha</th><th>Hora</th></tr>
                </thead>
                <tbody>
                  {d.prebautismal.filas.map((f) => (
                    <tr><td>{f.dias}</td><td>{f.horario}</td></tr>
                  ))}
                </tbody>
              </table>
            </section>
          )}
        </div>

      </div>
    )}
  </div>
</Layout>

<style>
  .hero-interior {
    background: linear-gradient(135deg, #4a2515, #7a4020);
    color: #fff;
    padding: 3rem 0;
  }

  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.85; }

  .vacio { color: var(--color-muted); font-style: italic; padding: 2rem 0; }

  .grid-horarios {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .columna {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .bloque {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1.5rem;
  }

  .bloque h2 {
    font-size: 1.05rem;
    color: var(--color-primary);
    margin-bottom: 0.3rem;
  }

  .subtitulo {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  .texto-simple {
    width: 100%;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    background: #fdf8f3;
    padding: 0.6rem 0.9rem;
    border-radius: 4px;
    display: inline-block;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }

  th {
    background: var(--color-primary);
    color: #fff;
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  tr:last-child td { border-bottom: none; }
  tr:nth-child(even) td { background: var(--color-bg); }

  .nota {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .grid-horarios { grid-template-columns: 1fr; }
  }
</style>
