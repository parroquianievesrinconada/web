---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const entrada = await getEntry("paginas", "historia");
const { Content } = await render(entrada);
---

<Layout title="Historia y Patrimonio">
  <div class="hero-interior">
    <div class="container">
      <h1>Historia y Patrimonio</h1>
      <p>La Parroquia de La Rinconada, un testimonio de fe a lo largo de los siglos</p>
    </div>
  </div>

  <div class="container">
    <div class="galeria">
      <div class="galeria-item">
        <img src="/uploads/historia-1.webp" alt="Retablo Mayor" loading="lazy" />
      </div>
      <div class="galeria-item">
        <img src="/uploads/historia-2.webp" alt="Torre Campanario" loading="lazy" />
      </div>
      <div class="galeria-item">
        <img src="/uploads/historia-3.webp" alt="Nave Central" loading="lazy" />
      </div>
    </div>

    <div class="cuerpo">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .hero-interior {
    background: linear-gradient(135deg, #4a2515, #7a4020);
    color: #fff;
    padding: 3rem 0;
  }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.85; }

  .galeria {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .galeria-item {
    border-radius: 6px;
    overflow: hidden;
    height: 200px;
  }

  .galeria-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cuerpo { max-width: 760px; }

  .cuerpo :global(h2) {
    font-size: 1.4rem;
    color: var(--color-primary);
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cuerpo :global(p) { margin-bottom: 0.9rem; line-height: 1.8; }

  .cuerpo :global(ul) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .cuerpo :global(ul li) {
    padding: 0.75rem 1rem;
    background: #fff;
    border-left: 3px solid var(--color-primary);
    border-radius: 0 4px 4px 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .galeria { grid-template-columns: 1fr 1fr; }
  }
</style>
