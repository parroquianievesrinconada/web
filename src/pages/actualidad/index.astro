---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { extractoDeAnuncio } from "../../lib/anuncios";

const fechaDeAnuncio = (anuncio: any): Date => {
  if (anuncio.data.date) return new Date(anuncio.data.date);
  const match = anuncio.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const anuncios = (await getCollection("anuncios"))
  .sort((a, b) => fechaDeAnuncio(b).valueOf() - fechaDeAnuncio(a).valueOf());

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title="Anuncios">
  <div class="hero-interior">
    <div class="container">
      <h1>Anuncios</h1>
      <p>Toda la actualidad de la parroquia</p>
    </div>
  </div>

  <div class="container">
    {anuncios.length === 0 ? (
      <p class="vacio">No hay anuncios publicados todavía.</p>
    ) : (
      <ul class="lista">
        {anuncios.map((anuncio) => (
          <li class="item">
            {anuncio.data.galeria?.[0]?.imagen && (
              <a href={`/actualidad/${anuncio.id}`} class="item-img-wrap">
                <img src={anuncio.data.galeria?.[0]?.imagen} alt={anuncio.data.title} class="item-img" loading="lazy" />
              </a>
            )}
            <div class="item-body">
              <time class="item-fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
              <h2><a href={`/actualidad/${anuncio.id}`}>{anuncio.data.title}</a></h2>
              {extractoDeAnuncio(anuncio.body) && <p>{extractoDeAnuncio(anuncio.body)}</p>}
              <a href={`/actualidad/${anuncio.id}`} class="leer-mas">Leer más →</a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>

<style>
  .hero-interior { background: linear-gradient(135deg, #4a2515, #7a4020); color: #fff; padding: 3rem 0; }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.85; }

  .vacio { color: var(--color-muted); font-style: italic; }
  .lista { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; }

  .item { background: #fff; border: 1px solid var(--color-border); border-radius: 6px; overflow: hidden; display: flex; }
  .item-img-wrap { flex-shrink: 0; }
  .item-img { width: 200px; height: 100%; object-fit: cover; display: block; }
  .item-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .item-fecha { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-primary); font-weight: 600; }
  .item-body h2 { font-size: 1.15rem; }
  .item-body h2 a { color: var(--color-text); }
  .item-body h2 a:hover { color: var(--color-primary); text-decoration: none; }
  .item-body p { font-size: 0.9rem; color: var(--color-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .leer-mas { font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.25rem; }

  @media (max-width: 500px) {
    .item { flex-direction: column; }
    .item-img { width: 100%; height: 160px; }
  }
</style>
