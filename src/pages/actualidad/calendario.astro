---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const entrada = await getEntry("paginas", "calendario");
const { Content } = await render(entrada);

const hoy = new Date();
const año = hoy.getFullYear();
const mes = hoy.getMonth();
const diaHoy = hoy.getDate();

const primerDia = new Date(año, mes, 1).getDay();
const diasEnMes = new Date(año, mes + 1, 0).getDate();
const primerDiaEu = primerDia === 0 ? 6 : primerDia - 1;

const nombreMes = hoy.toLocaleDateString("es-ES", { month: "long", year: "numeric" });

const celdas: (number | null)[] = [];
for (let i = 0; i < primerDiaEu; i++) celdas.push(null);
for (let d = 1; d <= diasEnMes; d++) celdas.push(d);
while (celdas.length % 7 !== 0) celdas.push(null);

const semanas: (number | null)[][] = [];
for (let i = 0; i < celdas.length; i += 7) semanas.push(celdas.slice(i, i + 7));

const DIAS = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];

const mesActual = mes + 1; // getMonth() es 0-indexed
const eventosRaw = (entrada.data.eventos ?? []).filter((ev) => ev.mes === mesActual);
const eventos: Record<number, { texto: string; tipo: string }[]> = {};
for (const ev of eventosRaw) {
  if (!eventos[ev.dia]) eventos[ev.dia] = [];
  eventos[ev.dia].push({ texto: ev.texto, tipo: ev.tipo });
}
---

<Layout title="Calendario Litúrgico">
  <div class="hero-interior">
    <div class="container">
      <h1>Calendario Litúrgico</h1>
      <p>Festividades y eventos de la parroquia</p>
    </div>
  </div>

  <div class="container">
    <div class="nav-actualidad">
      <a href="/actualidad" class="tab">Noticias</a>
      <a href="/actualidad/calendario" class="tab active">Calendario Litúrgico</a>
    </div>

    <div class="calendario-wrap">
      <div class="calendario-header">
        <h2>{nombreMes.charAt(0).toUpperCase() + nombreMes.slice(1)}</h2>
      </div>

      <div class="calendario">
        {DIAS.map((dia) => (
          <div class="cal-cabecera">{dia}</div>
        ))}

        {semanas.map((semana) =>
          semana.map((dia) => (
            <div class={`cal-dia ${dia === null ? "vacio" : ""} ${dia === diaHoy ? "hoy" : ""} ${dia !== null && eventos[dia] ? "tiene-eventos" : ""}`}>
              {dia !== null && (
                <>
                  <span class="cal-num">{dia}</span>
                  {eventos[dia] && (
                    <div class="cal-eventos">
                      {eventos[dia].map((ev) => (
                        <span class={`cal-evento tipo-${ev.tipo}`}>{ev.texto}</span>
                      ))}
                    </div>
                  )}
                </>
              )}
            </div>
          ))
        )}
      </div>

      <div class="leyenda">
        <span class="leyenda-item"><span class="dot tipo-misa"></span>Misa especial</span>
        <span class="leyenda-item"><span class="dot tipo-sacramento"></span>Sacramento</span>
        <span class="leyenda-item"><span class="dot tipo-pastoral"></span>Pastoral</span>
        <span class="leyenda-item"><span class="dot tipo-formacion"></span>Formación</span>
        <span class="leyenda-item"><span class="dot tipo-especial"></span>Evento especial</span>
        <span class="leyenda-item"><span class="dot tipo-festivo"></span>Festividad</span>
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero-interior { background: linear-gradient(135deg, #4a2515, #7a4020); color: #fff; padding: 3rem 0; }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.85; }

  .nav-actualidad { display: flex; gap: 0; border-bottom: 2px solid var(--color-primary); margin-bottom: 2rem; }
  .tab { padding: 0.6rem 1.25rem; font-size: 0.85rem; font-weight: 600; color: var(--color-muted); text-decoration: none; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: color 0.2s; }
  .tab:hover { color: var(--color-primary); text-decoration: none; }
  .tab.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

  .calendario-wrap {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .calendario-header {
    background: var(--color-primary);
    color: #fff;
    padding: 1rem 1.5rem;
  }

  .calendario-header h2 { color: #fff; font-size: 1.2rem; }

  .calendario {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    border-top: 1px solid var(--color-border);
  }

  .cal-cabecera {
    padding: 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .cal-dia {
    min-height: 80px;
    padding: 0.4rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    position: relative;
  }

  .cal-dia:nth-child(7n) { border-right: none; }
  .cal-dia.vacio { background: var(--color-bg); }
  .cal-dia.hoy { background: #fff8f0; }
  .cal-dia.hoy .cal-num {
    background: var(--color-primary);
    color: #fff;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cal-num { font-size: 0.85rem; font-weight: 600; display: block; margin-bottom: 0.25rem; }
  .cal-eventos { display: flex; flex-direction: column; gap: 2px; }

  .cal-evento {
    font-size: 0.68rem;
    padding: 1px 4px;
    border-radius: 3px;
    line-height: 1.4;
    display: block;
  }

  .tipo-misa { background: #fdebd0; color: #7d3c00; }
  .tipo-sacramento { background: #d5e8d4; color: #1e5c1e; }
  .tipo-pastoral { background: #d6eaf8; color: #1a5276; }
  .tipo-formacion { background: #e8daef; color: #6c3483; }
  .tipo-especial { background: #fde8e8; color: #7b1e1e; }
  .tipo-festivo { background: #fef9c3; color: #7d6608; }

  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .leyenda-item { display: flex; align-items: center; gap: 0.35rem; font-size: 0.75rem; color: var(--color-muted); }

  .dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
  .dot.tipo-misa { background: #fdebd0; border: 1px solid #c99060; }
  .dot.tipo-sacramento { background: #d5e8d4; border: 1px solid #5a9c5a; }
  .dot.tipo-pastoral { background: #d6eaf8; border: 1px solid #5a90c0; }
  .dot.tipo-formacion { background: #e8daef; border: 1px solid #a070c0; }
  .dot.tipo-especial { background: #fde8e8; border: 1px solid #c07070; }
  .dot.tipo-festivo { background: #fef9c3; border: 1px solid #c0b030; }

  .proximos { margin-top: 1.5rem; }
  .proximos h3 { font-size: 1.1rem; color: var(--color-primary); margin-bottom: 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--color-border); }

  .proximos-cuerpo :global(ul) { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .proximos-cuerpo :global(li) { font-size: 0.9rem; padding-left: 1rem; border-left: 2px solid var(--color-primary); }

  @media (max-width: 600px) {
    .cal-dia { min-height: 50px; }
    .cal-evento { display: none; }
    .cal-dia.tiene-eventos::after { content: "•"; position: absolute; bottom: 2px; right: 4px; color: var(--color-primary); font-size: 1rem; }
  }
</style>
