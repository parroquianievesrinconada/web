---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const anuncios = await getCollection("anuncios");
  return anuncios.map((anuncio) => ({
    params: { slug: anuncio.id },
    props: { anuncio },
  }));
}

const { anuncio } = Astro.props;
const { Content } = await render(anuncio);

const fechaDeAnuncio = (a: any): Date => {
  if (a.data.date) return new Date(a.data.date);
  const match = a.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { weekday: "long", day: "numeric", month: "long", year: "numeric" });

const galeria = anuncio.data.galeria ?? [];
---

<Layout title={anuncio.data.title}>
  <div class="container">
    <nav class="migas">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/actualidad">Anuncios</a>
    </nav>

    <article class="articulo">
      <header class="cabecera">
        <time class="fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
        <h1>{anuncio.data.title}</h1>
        <div class="separador"></div>
      </header>
      <div class="cuerpo">
        <Content />
      </div>

      {galeria.length > 0 && (
        <section class="galeria">
          {galeria.map((g) => (
            <figure>
              <img src={g.imagen} alt={g.pie ?? anuncio.data.title} class="ampliable" loading="lazy" />
              {g.pie && <figcaption>{g.pie}</figcaption>}
            </figure>
          ))}
        </section>
      )}
    </article>

    <a href="/actualidad" class="volver">← Volver a anuncios</a>
  </div>

  <div id="lightbox" class="lightbox" hidden>
    <button class="lightbox-cerrar" aria-label="Cerrar">&times;</button>
    <img class="lightbox-img" src="" alt="" />
  </div>
</Layout>

<style>
  .ampliable { cursor: zoom-in; }

  /* Las imágenes se ven enteras (suelen ser carteles con la información del anuncio) */
  .galeria { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2rem; }
  .galeria figure { margin: 0; }
  .galeria img { width: 100%; height: auto; border-radius: 4px; display: block; }
  .galeria figcaption { font-size: 0.82rem; color: var(--color-muted); margin-top: 0.4rem; line-height: 1.4; }

  .lightbox { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.92); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .lightbox[hidden] { display: none; }
  .lightbox-img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 4px; }
  .lightbox-cerrar { position: absolute; top: 1rem; right: 1rem; background: rgba(255, 255, 255, 0.12); border: none; color: #fff; font-size: 1.8rem; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1; transition: background 0.2s ease; }
  .lightbox-cerrar:hover { background: rgba(255, 255, 255, 0.25); }

  @media (max-width: 600px) {
    .lightbox { padding: 1rem; }
  }

  .migas { display: flex; gap: 0.4rem; align-items: center; font-size: 0.8rem; color: var(--color-muted); margin-bottom: 2rem; margin-top: 1.5rem; }
  .migas a { color: var(--color-muted); }
  .migas a:hover { color: var(--color-primary); text-decoration: none; }

  .articulo { max-width: 680px; }
  .cabecera { margin-bottom: 2rem; }

  .fecha { display: block; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-primary); margin-bottom: 0.6rem; }

  h1 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); line-height: 1.2; margin-bottom: 1rem; }


  .separador { width: 3rem; height: 3px; background: var(--color-primary); border-radius: 2px; }

  .cuerpo { font-size: 1.02rem; line-height: 1.85; }
  .cuerpo :global(h2) { font-size: 1.25rem; margin: 2rem 0 0.6rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .cuerpo :global(h3) { font-size: 1.08rem; margin: 1.5rem 0 0.5rem; }
  .cuerpo :global(p) { margin-bottom: 1.1rem; }
  .cuerpo :global(ul), .cuerpo :global(ol) { padding-left: 1.5rem; margin-bottom: 1.1rem; }
  .cuerpo :global(img) { width: 100%; border-radius: 4px; margin: 1.5rem 0; cursor: zoom-in; }

  .volver { display: inline-block; margin-top: 3rem; margin-bottom: 1rem; font-size: 0.85rem; color: var(--color-muted); text-decoration: none; border-top: 1px solid var(--color-border); padding-top: 1.5rem; width: 100%; max-width: 680px; }
  .volver:hover { color: var(--color-primary); }
</style>

<script is:inline>
  (function() {
    var lightbox = document.getElementById("lightbox");
    if (!lightbox) return;
    var lightboxImg = lightbox.querySelector(".lightbox-img");

    function close() {
      lightbox.hidden = true;
      lightboxImg.src = "";
      document.body.style.overflow = "";
    }

    document.querySelectorAll(".ampliable, .cuerpo img").forEach(function(img) {
      img.addEventListener("click", function() {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
      });
    });

    lightbox.querySelector(".lightbox-cerrar").addEventListener("click", close);
    lightbox.addEventListener("click", function(e) {
      if (e.target === lightbox) close();
    });
    document.addEventListener("keydown", function(e) {
      if (e.key === "Escape" && !lightbox.hidden) close();
    });
  })();
</script>
