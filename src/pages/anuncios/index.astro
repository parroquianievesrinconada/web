---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const fechaDeAnuncio = (anuncio: any): Date => {
  if (anuncio.data.date) return new Date(anuncio.data.date);
  const match = anuncio.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const anuncios = (await getCollection("anuncios"))
  .sort((a, b) => fechaDeAnuncio(b).valueOf() - fechaDeAnuncio(a).valueOf());

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title="Anuncios">
  <div class="container">
    <h1>Tablón de anuncios</h1>

    {anuncios.length === 0 ? (
      <p class="vacio">No hay anuncios publicados todavía.</p>
    ) : (
      <ul class="lista">
        {anuncios.map((anuncio) => (
          <li class="item">
            {anuncio.data.image && (
              <a href={`/anuncios/${anuncio.id}`} class="item-img-wrap">
                <img src={anuncio.data.image} alt={anuncio.data.title} class="item-img" />
              </a>
            )}
            <div class="item-body">
              <time class="item-fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
              <h2><a href={`/anuncios/${anuncio.id}`}>{anuncio.data.title}</a></h2>
              <p>{anuncio.data.summary}</p>
              <a href={`/anuncios/${anuncio.id}`} class="leer-mas">Leer más →</a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>

<style>
  h1 {
    font-size: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  .vacio { color: var(--color-muted); font-style: italic; }

  .lista { list-style: none; display: flex; flex-direction: column; gap: 1.5rem; }

  .item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
  }

  .item-img-wrap { flex-shrink: 0; }

  .item-img {
    width: 200px;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .item-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }

  .item-fecha { font-size: 0.8rem; color: var(--color-muted); }

  .item-body h2 { font-size: 1.2rem; }
  .item-body h2 a { color: var(--color-text); }
  .item-body h2 a:hover { color: var(--color-primary); text-decoration: none; }

  .item-body p { font-size: 0.95rem; color: var(--color-muted); }

  .leer-mas { font-size: 0.85rem; font-weight: 600; margin-top: 0.25rem; }

  @media (max-width: 500px) {
    .item { flex-direction: column; }
    .item-img { width: 100%; height: 160px; }
  }
</style>
