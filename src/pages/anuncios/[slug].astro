---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const anuncios = await getCollection("anuncios");
  return anuncios.map((anuncio) => ({
    params: { slug: anuncio.id },
    props: { anuncio },
  }));
}

const { anuncio } = Astro.props;
const { Content } = await render(anuncio);

const fechaDeAnuncio = (a: any): Date => {
  if (a.data.date) return new Date(a.data.date);
  const match = a.id.match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : new Date();
};

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Layout title={anuncio.data.title}>
  {anuncio.data.image && (
    <div class="portada-wrap">
      <img src={anuncio.data.image} alt={anuncio.data.title} class="portada" />
    </div>
  )}

  <div class="container">
    <nav class="migas">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/anuncios">Anuncios</a>
    </nav>

    <article class="articulo">
      <header class="cabecera">
        <time class="fecha">{formatFecha(fechaDeAnuncio(anuncio))}</time>
        <h1>{anuncio.data.title}</h1>
        <p class="entradilla">{anuncio.data.summary}</p>
        <div class="separador"></div>
      </header>

      <div class="cuerpo">
        <Content />
      </div>
    </article>

    <a href="/anuncios" class="volver">← Volver al tablón de anuncios</a>
  </div>
</Layout>

<style>
  /* Imagen a ancho completo antes del container */
  .portada-wrap {
    width: 100%;
    max-height: 420px;
    overflow: hidden;
  }

  .portada {
    width: 100%;
    height: 420px;
    object-fit: cover;
    display: block;
  }

  /* Migas de pan */
  .migas {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
    margin-top: 1.5rem;
  }

  .migas a { color: var(--color-muted); }
  .migas a:hover { color: var(--color-primary); text-decoration: none; }

  /* Artículo */
  .articulo { max-width: 680px; }

  .cabecera { margin-bottom: 2rem; }

  .fecha {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .entradilla {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .separador {
    width: 3rem;
    height: 3px;
    background: var(--color-primary);
    border-radius: 2px;
  }

  /* Cuerpo del texto */
  .cuerpo {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--color-text);
  }

  .cuerpo :global(h2) {
    font-size: 1.25rem;
    margin: 2rem 0 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .cuerpo :global(h3) { font-size: 1.08rem; margin: 1.5rem 0 0.5rem; }

  .cuerpo :global(p) { margin-bottom: 1.1rem; }

  .cuerpo :global(ul),
  .cuerpo :global(ol) { padding-left: 1.5rem; margin-bottom: 1.1rem; }

  .cuerpo :global(li) { margin-bottom: 0.3rem; }

  .cuerpo :global(img) {
    width: 100%;
    border-radius: 4px;
    margin: 1.5rem 0;
  }

  .cuerpo :global(strong) { color: var(--color-text); }

  /* Volver */
  .volver {
    display: inline-block;
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: none;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
    width: 100%;
    max-width: 680px;
  }

  .volver:hover { color: var(--color-primary); }
</style>
