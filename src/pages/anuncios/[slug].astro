---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const anuncios = await getCollection("anuncios");
  return anuncios.map((anuncio) => ({
    params: { slug: anuncio.id },
    props: { anuncio },
  }));
}

const { anuncio } = Astro.props;
const { Content } = await render(anuncio);

const formatFecha = (date: Date) =>
  date.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title={anuncio.data.title}>
  <div class="container">
    <a href="/anuncios" class="volver">← Volver a anuncios</a>

    <article class="articulo">
      {anuncio.data.image && (
        <img src={anuncio.data.image} alt={anuncio.data.title} class="portada" />
      )}

      <header class="articulo-header">
        <time class="fecha">{formatFecha(anuncio.data.date)}</time>
        <h1>{anuncio.data.title}</h1>
        <p class="resumen">{anuncio.data.summary}</p>
      </header>

      <div class="contenido">
        <Content />
      </div>
    </article>
  </div>
</Layout>

<style>
  .volver {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .volver:hover { color: var(--color-primary); text-decoration: none; }

  .articulo { max-width: 700px; }

  .portada {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 1.5rem;
  }

  .articulo-header { margin-bottom: 2rem; }

  .fecha { font-size: 0.85rem; color: var(--color-muted); }

  h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0.3rem 0 0.75rem;
  }

  .resumen {
    font-size: 1.05rem;
    color: var(--color-muted);
    font-style: italic;
    border-left: 3px solid var(--color-primary);
    padding-left: 1rem;
  }

  .contenido {
    font-size: 1rem;
    line-height: 1.8;
  }

  .contenido :global(h2) { font-size: 1.3rem; margin: 1.5rem 0 0.5rem; }
  .contenido :global(h3) { font-size: 1.1rem; margin: 1.25rem 0 0.5rem; }
  .contenido :global(p) { margin-bottom: 1rem; }
  .contenido :global(ul), .contenido :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .contenido :global(img) { border-radius: 4px; margin: 1rem 0; }
</style>
