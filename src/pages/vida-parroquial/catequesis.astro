---
import Layout from "../../layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const entrada = await getEntry("paginas", "catequesis");
const { Content } = await render(entrada);
---

<Layout title="Catequesis">
  <div class="hero-interior">
    <div class="container">
      <h1>Catequesis</h1>
      <p>Formación en la fe para niños, jóvenes y adultos</p>
    </div>
  </div>

  <div class="container">
    <div class="cuerpo">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .hero-interior {
    background: linear-gradient(135deg, #4a2515, #7a4020);
    color: #fff;
    padding: 3rem 0;
  }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.85; }

  .cuerpo { max-width: 760px; font-size: 1rem; line-height: 1.8; }

  .cuerpo :global(p) { margin-bottom: 1rem; }

  .cuerpo :global(h2) {
    font-size: 1.2rem;
    color: var(--color-primary);
    margin: 2rem 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .cuerpo :global(ul) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .cuerpo :global(li) { margin-bottom: 0.4rem; }

  .cuerpo :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .cuerpo :global(a) { color: var(--color-primary); }
</style>
