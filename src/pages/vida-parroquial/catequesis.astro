---
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";
import { marked } from "marked";

const entrada = await getEntry("paginas", "catequesis");

marked.setOptions({ gfm: true, breaks: false });

const tabs: { id: string; label: string; html: string }[] = [];

if (entrada?.data.visionGeneral) {
  tabs.push({
    id: "tab-general",
    label: "Visión general",
    html: await marked.parse(entrada.data.visionGeneral),
  });
}
if (entrada?.data.catequesisAdultos) {
  tabs.push({
    id: "tab-adultos",
    label: "Catequesis de Adultos",
    html: await marked.parse(entrada.data.catequesisAdultos),
  });
}
---

<Layout title={entrada?.data.title ?? "Pastoral de Catequesis"}>
  <div class="hero-interior">
    <div class="container">
      <h1>{entrada?.data.title ?? "Pastoral de Catequesis"}</h1>
      <p>Itinerarios de fe para niños, jóvenes y adultos</p>
    </div>
  </div>

  <div class="container">
    {tabs.length === 0 ? (
      <p class="vacio">Próximamente publicaremos aquí la información de la Pastoral de Catequesis.</p>
    ) : (
      <div class="tabs-wrap">
        {tabs.map((t, i) => (
          <input type="radio" name="catequesis-tab" id={t.id} class="tab-radio" checked={i === 0} />
        ))}

        <div class="tabs-lista" role="tablist">
          {tabs.map((t) => (
            <label for={t.id} class="tab-label" role="tab">{t.label}</label>
          ))}
        </div>

        <div class="tabs-paneles">
          {tabs.map((t) => (
            <div class="panel">
              <div class="panel-cuerpo" set:html={t.html} />
            </div>
          ))}
        </div>
      </div>
    )}

    <section class="contacto-final">
      <h2>¿Te interesa participar?</h2>
      <p>Acércate al <strong>despacho parroquial</strong> o contacta con nosotros a través de la <a href="/contacto">página de contacto</a> para más información sobre horarios e inscripciones.</p>
    </section>
  </div>
</Layout>

<style>
  .hero-interior { background: linear-gradient(135deg, #4a2515, #7a4020); color: #fff; padding: 3rem 0; }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.9; font-size: 1.05rem; }

  .vacio { color: var(--color-muted); font-style: italic; padding: 2rem 0; text-align: center; }

  .tabs-wrap { margin-top: 1.5rem; }

  .tab-radio { display: none; }

  .tabs-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: 2px solid var(--color-primary);
    margin-bottom: 0;
  }

  .tab-label {
    padding: 0.7rem 1.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-muted);
    cursor: pointer;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    transition: color 0.2s, border-color 0.2s;
    user-select: none;
  }

  .tab-label:hover { color: var(--color-primary); }

  .tabs-paneles {
    background: #fff;
    border: 1px solid var(--color-border);
    border-top: none;
    border-radius: 0 0 6px 6px;
  }

  .panel { display: none; padding: 2rem 1.75rem; }

  .panel-cuerpo { font-size: 1rem; line-height: 1.75; max-width: 760px; }
  .panel-cuerpo :global(p) { margin-bottom: 0.9rem; }
  .panel-cuerpo :global(ul),
  .panel-cuerpo :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .panel-cuerpo :global(li) { margin-bottom: 0.4rem; }
  .panel-cuerpo :global(h2) {
    font-size: 1.1rem;
    color: var(--color-primary);
    margin: 1.5rem 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .panel-cuerpo :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    background: var(--color-bg);
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    color: var(--color-muted);
    font-style: italic;
    font-size: 0.92rem;
  }
  .panel-cuerpo :global(strong) { color: var(--color-primary); }

  #tab-general:checked ~ .tabs-lista label[for="tab-general"],
  #tab-adultos:checked ~ .tabs-lista label[for="tab-adultos"] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  #tab-general:checked ~ .tabs-paneles .panel:nth-of-type(1),
  #tab-adultos:checked ~ .tabs-paneles .panel:nth-of-type(2) {
    display: block;
  }

  .contacto-final {
    text-align: center;
    padding: 2.5rem 1rem;
    border-top: 2px solid var(--color-border);
    margin-top: 2.5rem;
  }

  .contacto-final h2 {
    font-size: 1.15rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .contacto-final p { color: var(--color-muted); }

  @media (max-width: 600px) {
    .tab-label { padding: 0.6rem 0.9rem; font-size: 0.82rem; }
    .panel { padding: 1.5rem 1rem; }
  }
</style>
