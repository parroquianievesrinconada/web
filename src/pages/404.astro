---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada">
  <div class="hero-interior">
    <div class="container">
      <h1>404</h1>
      <p>La página que buscas no existe</p>
    </div>
  </div>

  <div class="container error-wrap">
    <p class="mensaje">
      Lo sentimos, la página que buscas no existe o ha sido movida.
    </p>
    <a href="/" class="btn">Volver al inicio</a>
  </div>
</Layout>

<style>
  .hero-interior { background: linear-gradient(135deg, #4a2515, #7a4020); color: #fff; padding: 3rem 0; }
  .hero-interior h1 { color: #fff; font-size: 2rem; margin-bottom: 0.5rem; }
  .hero-interior p { opacity: 0.85; }

  .error-wrap { text-align: center; padding: 4rem 1.5rem; }
  .mensaje { font-size: 1.05rem; color: var(--color-muted); margin-bottom: 2rem; }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: background 0.2s;
  }
  .btn:hover { background: var(--color-primary-light); color: #fff; text-decoration: none; }
</style>
